<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.CAMERA" />
    <!--
        Declaring CAMERA makes Play treat android.hardware.camera as required
        and hides the app from devices without one. Only the scan-meal screen
        and the "take a photo" pickers use it, so it stays optional.
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!--
        Declared so the app can show the system media-access prompt before it
        opens the gallery — a deliberate product decision, not a technical
        requirement. Picking itself needs neither: every gallery pick goes
        through ACTION_PICK_IMAGES (see configureMediaPickers) and every
        document pick through ACTION_OPEN_DOCUMENT, both of which run out of
        process and hand back a URI grant per item.

        That separation is what keeps the original bug fixed. The picker never
        queries MediaStore, so whatever the user answers here cannot filter what
        the picker shows — "Select photos" no longer pins the app to the subset
        granted the first time.

        READ_MEDIA_VISUAL_USER_SELECTED is what puts the third option — "Select
        photos and videos" — in that dialog on Android 14+, and what makes the
        resulting partial grant persist instead of being re-asked every launch.
        permission_handler reports it as PermissionStatus.limited, which
        MediaPermissions.ensure accepts as success.

        Declaring it was the original bug when the app read MediaStore itself:
        the partial grant pinned the picker to the subset chosen the first time.
        It is safe now for the same reason the other two are — ACTION_PICK_IMAGES
        never reads any of them, so a limited grant still browses the full
        library and every pick returns whatever the user actually selected.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!--
        open_filex merges these in defensively, for opening files by raw path.
        Every path this app hands it is inside getTemporaryDirectory() (see
        AttachmentOpener) and travels as a FileProvider URI grant, so they buy
        nothing here. Stripped rather than shipped unused.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <!-- Chat: voice message recording -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Location permissions for map picker -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!--
        Activity recognition — the OS's STILL / WALKING classifier. The step
        sensor is a vibration counter and credits a shaken phone as walking;
        this is what tells the two apart, and unlike GPS it works indoors.
        The plugin does not declare it, so it has to be declared here.
        The gms variant covers devices below Android 10.
    -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="com.google.android.gms.permission.ACTIVITY_RECOGNITION" />
    <!-- Internet for map tiles -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Network status for connectivity monitoring -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Required on Android 13+ to display notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Health & Activity tracking (ACTIVITY_RECOGNITION is declared above) -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity android:enableOnBackInvokedCallback="true"
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Health Connect permission rationale screen -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Routes the incoming App Link through the Flutter Router API
                 (GoRouter) rather than only bringing the app to the front.
                 Without it the link opens the app on whatever route it was
                 last showing. -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="true" />

            <!-- Deep links — https://fitnessday.tech/...
                 autoVerify=true triggers Android App Links (no chooser dialog).
                 The server must serve /.well-known/assetlinks.json with the
                 correct SHA-256 fingerprints for verification to succeed.

                 The paths are listed explicitly on purpose. A host-only filter
                 claims *every* URL on the domain — including /api/... and the
                 /uploads/chat-messages-media/... attachment links that
                 open_filex hands to the system — which would bounce those back
                 into the app instead of the browser or a document viewer.
                 Keep this list in sync with DeepLinkGuard and with the paths
                 in .well-known/apple-app-site-association. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="fitnessday.tech" />
                <data android:pathPrefix="/products/" />
                <data android:pathPrefix="/store/products/" />
                <data android:path="/open" />
                <data android:path="/user-home" />
                <data android:path="/challenges" />
                <data android:path="/user-profile" />
            </intent-filter>
        </activity>
        <!-- Health Connect activity for Android 14+ -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Required for Health Connect -->
        <package android:name="com.google.android.apps.healthdata" />
        <!-- Required to open Google Fit -->
        <package android:name="com.google.android.apps.fitness" />
        <!-- Required to request Health Connect permissions -->
        <intent>
            <action android:name="androidx.health.ACTION_REQUEST_HEALTH_PERMISSIONS" />
        </intent>
        <!-- share_plus: required on Android 11+ so the share sheet can list
             apps that accept plain text (ACTION_SEND). -->
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- open_filex: required on Android 11+ so the app can see which
             installed apps can VIEW a downloaded chat attachment (PDF, doc…).
             Without this the intent resolves to nothing and we fall back to
             the in-app WebView. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>
</manifest>
